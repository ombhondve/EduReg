# Copy this file to .env and fill in real values locally / in your
# deployment's secret manager. Never commit the filled-in .env — it's
# already in .gitignore.

# --- Database -------------------------------------------------------
host=
user=
password=
database=

# --- Auth -------------------------------------------------------------
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# --- Outbound email (invites / password reset) -------------------------
Email=
Email_Password=

# --- App runtime flags --------------------------------------------------
# Keep FLASK_DEBUG unset or "false" everywhere except your own local machine.
FLASK_DEBUG=false
FORCE_HTTPS=false
RATE_LIMIT_STORAGE_URI=memory://
